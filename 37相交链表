/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    ListNode *getIntersectionNode(ListNode *headA, ListNode *headB) {
        ListNode*c=headA;
        ListNode*d=headB;
        while(c!=d){
            c=c?c->next:headB;
            d=d?d->next:headA;
        }
        return c;

        
    }
};
